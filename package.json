{
  "name": "essence",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:tokens": "turbo run build --filter=@essence/tokens",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ui": "turbo run test:ui",
    "storybook": "turbo run storybook --filter=@essence/react",
    "docs:dev": "turbo run dev --filter=@essence/docs",
    "docs:build": "turbo run build --filter=@essence/docs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm publish -r",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "sync:figma": "turbo run sync:figma --filter=@essence/tools"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@turbo/gen": "^1.13.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "pnpm@9.0.0"
}